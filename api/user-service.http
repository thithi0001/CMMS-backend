@baseUrl = http://localhost:3000/api
@username = 
@password = 
@accessToken = {{login.response.body.$.data.accessToken}}
@refreshToken = {{login.response.body.$.data.refreshToken}}
@userId = {{createUser.response.body.$.data.id}}

### API health check
GET {{baseUrl}}/

### Auth: login (public)
# Run this request first to obtain tokens for the requests below.
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Auth: current user (requires login)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Auth: change password (requires login)
# Replace currentPassword/newPassword before running.
PATCH {{baseUrl}}/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{password}}",
  "newPassword": "NewPassword123"
}

### Auth: refresh token (public)
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Users: list (ADMIN or MANAGER)
GET {{baseUrl}}/users?page=1&limit=10&search=nv
Authorization: Bearer {{accessToken}}

### Users: update
PATCH {{baseUrl}}/users/5
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Users: create (ADMIN or MANAGER)
# @name createUser
POST {{baseUrl}}/users
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "username": "test.user01",
  "password": "TestPass123",
  "email": "test.user01@example.com",
  "roleCode": "EMPLOYEE",
  "fullname": "Test User",
  "dob": "2004-01-01",
  "phone": "0900000001"
}

### Users: get by ID
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}

### Users: change role (ADMIN)
PATCH {{baseUrl}}/users/{{userId}}/role
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roleCode": "TECHNICIAN"
}

### Users: deactivate (ADMIN)
# Run after creating the test user.
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}

### Employees: list
GET {{baseUrl}}/employees
Authorization: Bearer {{accessToken}}
